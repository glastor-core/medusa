# GLASTOR MEDUSA - Environment Configuration

# APILayer API Access Key (Obtain from https://apilayer.com/)
APILAYER_API_KEY=your_apilayer_api_key_here

# Port for local development (defaults to 8000)
PORT=8000

# Gateway Client Access Key (Optional: if set, clients must pass `x-medusa-key` or `Authorization: Bearer <key>`)
MEDUSA_API_KEY=

# Resilient Gateway Tuning
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_DEFAULT_TTL_SECONDS=300
STALE_WHILE_REVALIDATE_SECONDS=3600
