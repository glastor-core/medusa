{
  "name": "@glastor-core/medusa",
  "version": "0.2.0",
  "exports": "./src/server.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --unstable-kv --watch src/server.ts",
    "start": "deno run --allow-net --allow-env --unstable-kv src/server.ts",
    "test": "deno test --allow-net --allow-env --unstable-kv tests/",
    "check": "deno check src/server.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "doctor": "deno run -A jsr:@glastor-dev/samurai/cli doctor",
    "standards:update": "deno run -A jsr:@glastor-dev/samurai/cli update --org glastor-core --repo medusa"
  },
  "unstable": [
    "kv"
  ],
  "deploy": {
    "entrypoint": "src/server.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  }
}
